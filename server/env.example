# ── Mandarin: настройки сервера продаж (скопируйте в переменные окружения функции) ──
# Магазин ЮKassa: личный кабинет → Интеграция → Ключи API
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Цена в рублях (только здесь — сайт цену не задаёт)
PRICE_PRO=990
# PRICE_BUSINESS=2990

# Закрытый ключ продавца: python tools/keygen.py init → строка MANDARIN_PRIVATE_KEY=…
MANDARIN_PRIVATE_KEY=

# Сайт
SITE_URL=https://mandarin-app.ru
ALLOWED_ORIGINS=https://mandarin-app.ru,https://www.mandarin-app.ru
DOWNLOAD_URL=https://mandarin-app.ru/#download

# Чеки: none — самозанятый (доход в «Мой налог» регистрирует ЮKassa), yookassa — ИП с «Чеками от ЮKassa»
RECEIPT=none
VAT_CODE=1

# Почта для отправки ключей (Яндекс 360 / Mail.ru: пароль приложения, не основной пароль)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=sales@mandarin-app.ru
SMTP_PASSWORD=пароль_приложения
MAIL_FROM=sales@mandarin-app.ru
MAIL_FROM_NAME=Mandarin
SUPPORT_EMAIL=support@mandarin-app.ru

# Проверять, что уведомления приходят с адресов ЮKassa (1 — да)
CHECK_WEBHOOK_IP=1
