# ── Mandarin: настройки сервера продаж (скопируйте в переменные окружения функции) ──
# Робокасса: личный кабинет → Мои магазины → Технические настройки
ROBOKASSA_LOGIN=Mandarinapp
ROBOKASSA_PASSWORD1=xxxxxxxxxxxxxxxxxxxx
ROBOKASSA_PASSWORD2=yyyyyyyyyyyyyyyyyyyy
# Алгоритм подписи — ДОЛЖЕН совпадать с «Хэширование» в техн. настройках магазина (md5/sha256/sha512)
ROBOKASSA_HASH=sha256
# Тестовый режим: 1 — платежи не списывают деньги, используются ТЕСТОВЫЕ пароли ниже
ROBOKASSA_TEST=0
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=

# Цена в рублях (только здесь — сайт цену не задаёт)
PRICE_PRO=199
# PRICE_BUSINESS=2990

# Закрытый ключ продавца: python tools/keygen.py init → строка MANDARIN_PRIVATE_KEY=…
MANDARIN_PRIVATE_KEY=

# Сайт
SITE_URL=https://mandarinappkon.pages.dev
ALLOWED_ORIGINS=https://mandarinappkon.pages.dev
DOWNLOAD_URL=https://github.com/mandarinappkon/mandarin/releases/latest

# Чеки: none — самозанятый (Робокасса сама регистрирует доход в «Мой налог» по подключённому
#        счёту самозанятого), robokassa — передавать чек «Робочеки» (для ИП/ООО с фискализацией)
RECEIPT=none
# Параметры чека, если RECEIPT=robokassa:
# PAYMENT_OBJECT=service      # предмет расчёта (service / intellectual_activity)
# RECEIPT_TAX=none            # ставка НДС (none — без НДС)
# RECEIPT_SNO=usn_income      # система налогообложения (для ИП; у самозанятого не указывается)

# Почта и персональные данные НЕ собираются: ключ выдаётся на сайте и восстанавливается по номеру
# заказа. SMTP и адрес почты для отправки ключей больше не нужны.

# ── Настройка в личном кабинете Робокассы (Технические настройки магазина) ──
#   Result URL:  https://<адрес-функции>/?a=webhook   Метод: POST (или GET)
#   Success URL: https://mandarinappkon.pages.dev/success.html  Метод: GET
#   Fail URL:    https://mandarinappkon.pages.dev/index.html    Метод: GET
